{
  "entities": {
    "packages": {
      "title": "Packages",
      "description": "Photobooth packages",
      "properties": {
        "id": { "type": "number", "description": "Package ID" },
        "name": { "type": "string", "description": "Package name" },
        "price": { "type": "number", "description": "Price in IDR" },
        "duration": { "type": "number", "description": "Duration in minutes" },
        "photos_count": { "type": "number", "description": "Number of photos" },
        "description": { "type": "string", "description": "Package description" }
      },
      "required": ["name", "price", "duration", "photos_count"]
    },
    "frames": {
      "title": "Frames",
      "description": "Photobooth frames",
      "properties": {
        "id": { "type": "number", "description": "Frame ID" },
        "name": { "type": "string", "description": "Frame name" },
        "image": { "type": "string", "description": "Base64 or URL" },
        "photos_count": { "type": "number", "description": "Photos count" },
        "created_at": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["name", "image"]
    },
    "stickers": {
      "title": "Stickers",
      "description": "Photobooth stickers",
      "properties": {
        "id": { "type": "number", "description": "Sticker ID" },
        "name": { "type": "string", "description": "Sticker name" },
        "image": { "type": "string", "description": "Base64 or URL" },
        "created_at": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["name", "image"]
    },
    "sessions": {
      "title": "Sessions",
      "description": "Photobooth payment/photo sessions",
      "properties": {
        "id": { "type": "string", "description": "Session ID" },
        "session_code": { "type": "string", "description": "Unique session code" },
        "package_id": { "type": "number", "description": "Package ID" },
        "package_name": { "type": "string", "description": "Package name" },
        "price": { "type": "number", "description": "Price paid" },
        "photos_count": { "type": "number", "description": "Number of photos" },
        "payment_status": { "type": "string", "description": "pending / completed / cancelled" },
        "payment_method": { "type": "string", "description": "qris / cash" },
        "created_at": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["session_code", "package_id", "payment_status"]
